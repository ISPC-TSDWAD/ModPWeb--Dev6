# --- Django ---
SECRET_KEY=
# DEBUG=True solo en desarrollo local. En producción dejalo en False.
DEBUG=True
# Hosts permitidos separados por coma (ej: midominio.com,www.midominio.com)
ALLOWED_HOSTS=127.0.0.1,localhost
# Orígenes CORS permitidos separados por coma (ej: https://midominio.com).
# Si lo dejás vacío, en desarrollo se permite todo.
CORS_ALLOWED_ORIGINS=

# --- Base de datos (MySQL) ---
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Seed (datos de prueba) ---
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@edutools.edu.ar
SEED_ADMIN_PASSWORD=
