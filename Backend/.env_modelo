# --- Django ---
SECRET_KEY=
# DEBUG=True solo en desarrollo local. En producción dejalo en False.
DEBUG=True
# Hosts permitidos separados por coma (ej: midominio.com,www.midominio.com)
ALLOWED_HOSTS=127.0.0.1,localhost
# Orígenes CORS permitidos separados por coma (ej: https://midominio.com).
# Si lo dejás vacío, solo se permite el Angular local (http://localhost:4200).
# CORS nunca queda abierto a todos los orígenes.
CORS_ALLOWED_ORIGINS=
# Orígenes https de confianza para el login del /admin/ (producción).
CSRF_TRUSTED_ORIGINS=
# Base de datos: mysql (por defecto) o sqlite (si el hosting no ofrece MySQL gratis).
DB_ENGINE=mysql

# --- Base de datos (MySQL) ---
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Seed (datos de prueba) ---
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@edutools.edu.ar
# Sin valor por defecto: definí una clave fuerte o el seed no corre.
SEED_ADMIN_PASSWORD=
